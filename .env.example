#mode environtment
NODE_ENV=development 

# Used by Drizzle Kit commands.
DB_FILE_NAME=file:.data/qdc-local.db

# Used by the Nuxt server runtime.
NUXT_DB_FILE_NAME=file:.data/qdc-local.db
NUXT_STORAGE_ROOT=public/uploads

BETTER_AUTH_SECRET=replace-with-at-least-32-character-secret
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# Development seed admin. Do not use these defaults in a shared environment.
SEED_ADMIN_EMAIL=admin@qdc.local
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PASSWORD=qwertyuiop
